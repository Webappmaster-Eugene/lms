[
  {
    "uid": "lms-media-errors",
    "title": "LMS: ошибки доставки видео",
    "orgID": 1,
    "folderUID": "lms-learning",
    "ruleGroup": "LMS learning",
    "condition": "B",
    "for": "3m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "isPaused": false,
    "labels": {
      "service": "lms-platform",
      "severity": "warning",
      "responsible_role": "platform_operator"
    },
    "annotations": {
      "summary": "Более 5% ошибок видео и минимум 10 ошибок за 5 минут",
      "description": "Проверьте docs/learning-observability.md. Данные не содержат логинов, паролей и source URL.",
      "__dashboardUid__": "lms-learning-access",
      "__panelId__": "2"
    },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "prometheus",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(lms_learning_access_total{service_name=\"lms-platform\",resource=\"media\",outcome=\"error\"}[5m])) / clamp_min(sum(rate(lms_learning_access_total{service_name=\"lms-platform\",resource=\"media\",outcome=~\"allow|error\"}[5m])), 0.001)) > bool 0.05) * (sum(increase(lms_learning_access_total{service_name=\"lms-platform\",resource=\"media\",outcome=\"error\"}[5m])) >= bool 10) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "refId": "B",
          "type": "threshold",
          "conditions": [
            {
              "type": "query",
              "evaluator": {
                "type": "gt",
                "params": [
                  0.5
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "query": {
                "params": [
                  "B"
                ]
              }
            }
          ]
        }
      }
    ]
  },
