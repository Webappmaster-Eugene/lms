    "folderUID": "lms-learning",
    "ruleGroup": "LMS learning",
    "condition": "B",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "isPaused": false,
    "labels": {
      "service": "lms-platform",
      "severity": "warning",
      "responsible_role": "platform_operator"
    },
    "annotations": {
      "summary": "p95 больше 2 секунд при 50+ измерениях за 5 минут",
