{
  "name": "lms-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "node scripts/copy-monaco.mjs && node scripts/build-harness.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-monaco.mjs && node scripts/build-harness.mjs",
    "start": "next start",
    "lint": "eslint .",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed.ts",
    "seed:trainer": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed-trainer.ts",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "node scripts/build-harness.mjs",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run tests/smoke",
    "test:watch": "vitest",
    "smoke": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build:assets": "node scripts/copy-monaco.mjs && node scripts/build-harness.mjs",
    "codex": "node scripts/codex/harness.mjs launch",
    "codex:setup": "node scripts/codex/setup.mjs",
    "codex:sync": "node scripts/codex/harness.mjs sync",
    "codex:doctor": "node scripts/codex/harness.mjs doctor",
    "codex:verify": "node scripts/codex/harness.mjs verify",
    "codex:test": "node --test scripts/codex/harness.test.mjs",
    "codex:mcp-check": "node scripts/codex/mcp.mjs probe",
    "codex:browser-check": "node scripts/codex/mcp.mjs browser-check",
    "codex:native-check": "node scripts/codex/native-check.mjs",
    "codex:trust": "node scripts/codex/trust.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/email-nodemailer": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "graphql": "16.14.2",
    "import-in-the-middle": "3.0.0",
    "isolated-vm": "^6.2.0",
    "lucide-react": "0.577.0",
    "monaco-editor": "0.55.1",
    "mpegts.js": "^1.8.2",
    "next": "15.3.9",
    "next-themes": "0.4.6",
    "nodemailer": "9.1.1",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "9.1.0",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "require-in-the-middle": "8.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.33.5",
    "shiki": "3.23.0",
    "tailwind-merge": "3.6.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@next/eslint-plugin-next": "15.3.9",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "10.5.6",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.28",
    "sass": "1.104.0",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
