# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lms_platform

PAYLOAD_SECRET=your-secret-key-min-32-chars-long-here
# Базовый URL платформы. Используется во всех ссылках внутри писем —
# в проде обязательно https и реальный домен.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Initial admin (required on first launch with empty DB)
ADMIN_EMAIL=admin@mentorcareer.ru
ADMIN_PASSWORD=<strong-password>

# --- Email (SMTP) ---
# Почта отключается целиком, если SMTP_HOST пуст. Если он задан,
# SMTP_USER и SMTP_PASS обязательны — иначе приложение не стартует.
#
# VK WorkSpace: smtp.mail.ru, порт 465 (SSL) или 587 (STARTTLS).
# SMTP_PASS — это «пароль для внешнего приложения» из настроек ящика,
# обычный пароль аккаунта не подойдёт.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
# Полный адрес ящика, не логин.
SMTP_USER=noreply@mentorcareer.ru
SMTP_PASS=<app-password>
# Должен совпадать с SMTP_USER либо быть его подтверждённым алиасом,
# иначе сервер вернёт 553 Sender address rejected.
EMAIL_FROM_ADDRESS=noreply@mentorcareer.ru
EMAIL_FROM_NAME=MentorCareer

# Yandex Disk (optional, for auto-importing courses from YD folders)
# YANDEX_DISK_TOKEN=your-oauth-token

# OpenTelemetry (optional, disabled if OTEL_EXPORTER_OTLP_ENDPOINT is empty)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=lms-platform
