# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lms_platform

PAYLOAD_SECRET=your-secret-key-min-32-chars-long-here
# Используется во всех ссылках внутри писем — в проде реальный домен и https.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Initial admin (required on first launch with empty DB)
ADMIN_EMAIL=admin@mentorcareer.ru
ADMIN_PASSWORD=<strong-password>

# Email (SMTP). Пустой SMTP_HOST выключает почту целиком; заданный без
# SMTP_USER/SMTP_PASS не даст приложению стартовать — заполнять все три сразу.
# SMTP_PASS для VK WorkSpace — «пароль для внешнего приложения», не пароль аккаунта.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=noreply@mentorcareer.ru
SMTP_PASS=<app-password>
# Совпадает с SMTP_USER или его подтверждённый алиас, иначе 553 Sender address rejected.
EMAIL_FROM_ADDRESS=noreply@mentorcareer.ru
EMAIL_FROM_NAME=MentorCareer

# Yandex Disk (optional, for auto-importing courses from YD folders)
# YANDEX_DISK_TOKEN=your-oauth-token

# Web Push: одна постоянная пара VAPID для всех устройств. Не менять после подписок.
# Публичный ключ выдаётся авторизованному клиенту в runtime; приватный — только серверу.
# PUSH_VAPID_PUBLIC_KEY=<public-key>
# PUSH_VAPID_PRIVATE_KEY=<private-key>
# PUSH_VAPID_SUBJECT=https://learn.mentorcareer.ru

# OpenTelemetry (optional, disabled if OTEL_EXPORTER_OTLP_ENDPOINT is empty)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://lms-mentor-otel:4318
# OTEL_SERVICE_NAME=lms-platform
# Dedicated LMS collector exports to existing private Dokploy-network backends.
# These defaults need no credentials in the current monitoring stack.
# LMS_PROMETHEUS_REMOTE_WRITE_ENDPOINT=http://prometheus:9090/api/v1/write
# LMS_LOKI_OTLP_ENDPOINT=http://loki:3100/otlp
# LMS_TEMPO_OTLP_GRPC_ENDPOINT=tempo:4317
