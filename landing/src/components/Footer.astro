---
import { LMS_URL, AUTHOR_URL, TELEGRAM_URL } from '../config'

const YEAR = new Date().getFullYear()

const LINKS = [
  { href: LMS_URL, label: 'Платформа', external: false },
  { href: AUTHOR_URL, label: 'Сайт автора', external: true },
  { href: TELEGRAM_URL, label: 'Telegram', external: true },
] as const
---

<footer class="border-t border-line py-8">
  <div class="shell flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
    <div class="flex items-center gap-2.5">
      <span
        aria-hidden="true"
        class="flex h-5 w-5 items-center justify-center border border-line font-mono text-[0.55rem] text-ink-faint">&gt;_</span
      >
      <span class="font-mono text-xs text-ink-faint">MentorCareer © {YEAR}</span>
    </div>

    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Служебная навигация">
      {
        LINKS.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="font-mono text-xs text-ink-faint transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
