---
/** Шапка в виде панели вкладок редактора.
 *  Добавлено мобильное меню: в прошлой версии навигация была просто
 *  `hidden md:flex`, то есть на телефоне отсутствовала полностью. */
import { LMS_URL, NAV_ITEMS } from '../config'
---

<header class="sticky top-0 z-40 border-b border-line bg-ground/90 backdrop-blur-md">
  <div class="shell flex h-14 items-center gap-6">
    <a href="#top" class="flex shrink-0 items-center gap-2.5" aria-label="MentorCareer — в начало">
      <span
        aria-hidden="true"
        class="flex h-6 w-6 items-center justify-center border border-accent-dim font-mono text-[0.7rem] font-bold text-accent"
        >&gt;_</span
      >
      <span class="font-mono text-sm font-medium tracking-tight text-ink">mentorcareer</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Основная навигация">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="border-t-2 border-transparent px-3 py-[1.15rem] font-mono text-[0.8125rem] text-ink-faint transition-colors hover:border-accent hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href={LMS_URL} class="btn btn-solid ml-auto hidden !py-2 !text-[0.75rem] sm:inline-flex">Войти</a>

    <button
      type="button"
      id="nav-toggle"
      class="ml-auto flex h-9 w-9 items-center justify-center border border-line text-ink-dim transition-colors hover:border-accent-dim hover:text-ink md:hidden"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Открыть меню"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>
  </div>

  <div id="nav-panel" hidden class="border-t border-line bg-raised md:hidden">
    <nav class="shell flex flex-col py-2" aria-label="Мобильная навигация">
      {
        NAV_ITEMS.map((item) => (
          <a href={item.href} class="border-b border-line-soft py-3 font-mono text-sm text-ink-dim transition-colors hover:text-accent">
            <span aria-hidden="true" class="mr-2 text-ink-faint">▸</span>
            {item.label}
          </a>
        ))
      }
      <a href={LMS_URL} class="btn btn-solid mt-4 mb-2 justify-center">Войти в платформу</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')
  const panel = document.getElementById('nav-panel')

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню')
    }

    toggle.addEventListener('click', () => {
      setOpen(panel.hidden)
    })

    // Переход по якорю должен закрывать меню, иначе оно перекрывает цель.
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || panel.hidden) return
      setOpen(false)
      toggle.focus() // фокус не должен теряться в скрытой панели
    })

    // Возврат на десктоп при открытом меню оставлял бы его в DOM-потоке.
    const wide = window.matchMedia('(min-width: 768px)')
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false)
    })
  }
</script>
