---
import type { GuideStep } from '../data/guide'
import screens from '../data/screens.json'

interface Props {
  id: string
  screen: string
  alt: string
  steps: GuideStep[]
  mobile?: boolean
  /** Папка снимков в public: у инструкции по платформе и у буткемпа свои. */
  folder?: string
  /** Уровень заголовков шагов: на странице буткемпа скриншоты стоят внутри главы с h3. */
  level?: 3 | 4
}
const { id, screen, alt, steps, mobile = false, folder = 'guide', level = 3 } = Astro.props
const StepHeading = `h${level}` as 'h3' | 'h4'
const size = Object.entries(screens).find(([name]) => name === screen)?.[1]
if (!size) throw new Error(`Screenshot dimensions missing: ${screen}`)
---
<div class:list={['walkthrough', { 'walkthrough-mobile': mobile }]} data-walkthrough>
  <div class="screen-toolbar">
    <span data-tour-label>Показываем на экране</span>
    <span class="focus-count" data-focus-count>Шаг 1 из {steps.length}</span>
    <div class="screen-actions">
      <button type="button" class="play-guide" data-play aria-pressed="false"><span aria-hidden="true">▷</span> Показать шаги</button>
      <button type="button" class="focus-step" data-prev aria-label="Назад" aria-disabled="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
      <button type="button" class="focus-step" data-next aria-label="Дальше" aria-disabled={steps.length < 2 ? 'true' : 'false'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
      <button type="button" class="zoom-guide" data-zoom aria-haspopup="dialog"><span class="zoom-wide">Увеличить</span><span class="zoom-narrow">Весь экран</span></button>
    </div>
    <span class="tour-progress" data-tour-progress aria-hidden="true"></span>
  </div>
  <div class="screen-image">
    <div class="screen-canvas">
      <img src={`/${folder}/${screen}.webp`} alt={alt} width={size.width} height={size.height} loading="lazy" decoding="async" />
      {steps.map((step, i) => (
        <button type="button" class:list={['hotspot', { 'arrow-below': step.y < 10 }]} data-hotspot={i} data-x={step.x} data-y={step.y} data-active={i === 0 ? 'true' : 'false'} style={`--x:${step.x}%;--y:${step.y}%`} aria-label={`Шаг ${i + 1}: ${step.title}`} aria-pressed={i === 0 ? 'true' : 'false'} aria-describedby={`${id}-step-${i}`}>
          <span>{i + 1}</span>
          <svg class="pointer-arrow" viewBox="0 0 50 52" aria-hidden="true"><path d="M4 3 Q39 3 39 37 M29 28 L39 39 L48 28" /></svg>
        </button>
      ))}
    </div>
  </div>
  <div class="focus-dots" aria-hidden="true">{steps.map((_, i) => <span data-dot={i} data-active={i === 0 ? 'true' : 'false'}></span>)}</div>
  <ol class="screen-steps" aria-label="Пошаговое объяснение">
    {steps.map((step, i) => (
      <li data-step={i} data-title={step.title} data-active={i === 0 ? 'true' : 'false'}>
        <StepHeading><button type="button" data-select={i} aria-pressed={i === 0 ? 'true' : 'false'}><span class="step-number" aria-hidden="true">{i + 1}</span> {step.title}</button></StepHeading>
        <p id={`${id}-step-${i}`}>{step.text}</p>
      </li>
    ))}
  </ol>
  <p class="guide-status sr-only" role="status" aria-live="polite"></p>
</div>
