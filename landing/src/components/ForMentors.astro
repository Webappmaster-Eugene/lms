---
/** Блок 06 — для наставников.
 *  Другая аудитория, поэтому визуально приглушён и сдвинут в конец пути покупателя.
 *  Из прежнего TechAdvantages оставлены только облачное хранение и sandbox:
 *  «адаптивный дизайн» и «тёмная тема» — не преимущества, а гигиена. */
import SectionHead from './SectionHead.astro'
import Pane from './Pane.astro'

const CAPABILITIES = [
  'Умный парсинг имён: "1.1 - Название" → секция + урок',
  'Видео встраивается на платформу автоматически',
  'Ссылка на скачивание добавляется к каждому уроку',
  'Полная CMS: управление всем контентом через админ-панель',
  'Обратная связь: читайте комментарии учеников',
  'Гибкая настройка баллов и достижений',
] as const

const SOURCE_FILES = [
  '1.1 - Введение в Node.js.mp4',
  '1.2 - Установка окружения.mp4',
  '1.3 - Первая программа.mp4',
  '2.1 - Модули и require.mp4',
  '2.2 - npm и packages.mp4',
  '2.3 - Файловая система.mp4',
] as const

const RESULT_TREE = [
  { section: 'Раздел 1', count: '3 урока', lessons: ['Введение в Node.js', 'Установка окружения', 'Первая программа'] },
  { section: 'Раздел 2', count: '3 урока', lessons: ['Модули и require', 'npm и packages', 'Файловая система'] },
] as const

const TECH = [
  { title: 'Облачное хранение', desc: 'Видео на Яндекс.Диске — не тратите гигабайты SSD сервера' },
  { title: 'Безопасность', desc: 'Sandbox для кода, приватные комментарии, защита данных' },
] as const
---

<section id="for-mentors" class="band border-t border-line-soft">
  <div class="shell">
    <SectionHead
      index="06"
      label="для наставников"
      title="Автоматизация создания курсов"
      lead="Дай ссылку на папку Яндекс.Диска с видео — и получи готовый курс с секциями и уроками. Не нужно вручную создавать 40 уроков из 40 видео."
    />

    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="space-y-3 lg:col-span-7 min-w-0" data-reveal>
        <Pane path="disk.yandex.ru/d/abc123/" meta={`${SOURCE_FILES.length} файлов`}>
          <ul class="p-4 font-mono text-[0.8125rem] leading-[1.85] text-ink-dim">
            {SOURCE_FILES.map((file) => <li>{file}</li>)}
          </ul>
        </Pane>

        <div class="flex items-center gap-3 px-1" aria-hidden="true">
          <span class="font-mono text-xs text-accent">↓ импорт</span>
          <span class="h-px flex-1 bg-line-soft"></span>
        </div>

        <Pane path="курс создан автоматически" meta="2 раздела · 6 уроков">
          <div class="space-y-3 p-4 font-mono text-[0.8125rem]">
            {
              RESULT_TREE.map((group) => (
                <div>
                  <p class="text-ink">
                    {group.section} <span class="text-ink-faint">({group.count})</span>
                  </p>
                  <ul class="mt-1 border-l border-line pl-4 text-ink-dim">
                    {group.lessons.map((lesson) => (
                      <li>{lesson}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </Pane>
      </div>

      <div class="lg:col-span-5 min-w-0" data-reveal>
        <ul class="space-y-3">
          {
            CAPABILITIES.map((item) => (
              <li class="flex gap-3 text-[0.9375rem] text-ink-dim">
                <span aria-hidden="true" class="font-mono font-bold text-accent">
                  +
                </span>
                {item}
              </li>
            ))
          }
        </ul>

        <dl class="mt-8 space-y-3">
          {
            TECH.map((item) => (
              <div class="panel p-4">
                <dt class="font-mono text-[0.8125rem] text-ink">{item.title}</dt>
                <dd class="t-body mt-1 text-[0.8125rem]">{item.desc}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
