---
import { BOOTCAMP_PATH } from '../data/bootcamp'
import BrandMark from './BrandMark.astro'
import BrandWordmark from './BrandWordmark.astro'

interface Props {
  /** На странице буткемпа кнопка ведёт к форме, на остальных — к форме на странице буткемпа. */
  cta?: string
}
const { cta = `${BOOTCAMP_PATH}#apply` } = Astro.props
---
<header class="bc-header">
  <a class="bc-brand" href={BOOTCAMP_PATH}><BrandMark size={32} /><BrandWordmark class="bc-brand-word" /><span class="bc-brand-product">Буткемп Node.js</span></a>
  <a class="bc-header-cta" href={cta}>Оставить заявку</a>
</header>
