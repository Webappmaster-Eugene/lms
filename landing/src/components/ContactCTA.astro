---
/** Блок 07 — финал. Контакты подаются списком «ключ: значение»,
 *  а не четырьмя одинаковыми карточками. */
import { LMS_URL, AUTHOR_URL, TELEGRAM_URL, CHAT_URL, EMAIL } from '../config'

const CONTACTS = [
  { key: 'telegram', value: '@eugene_nadtocheev', href: TELEGRAM_URL, external: true },
  { key: 'чат учеников', value: 'mentorcareer_chat', href: CHAT_URL, external: true },
  { key: 'email', value: EMAIL, href: `mailto:${EMAIL}`, external: false },
  { key: 'сайт автора', value: 'nadtocheev.ru', href: AUTHOR_URL, external: true },
] as const
---

<section id="contacts" class="band border-t border-line-soft">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6 min-w-0" data-reveal>
      <div class="mb-6 flex items-center gap-3">
        <span class="font-mono text-xs tracking-[0.08em] text-accent">// 07</span>
        <span class="t-mono">старт</span>
        <span aria-hidden="true" class="h-px w-16 bg-line-soft"></span>
      </div>

      <h2 class="t-display text-ink">Готов начать?</h2>

      <p class="t-lead mt-6 max-w-lg">
        Присоединяйся к платформе MentorCareer и начни свой путь в разработке уже сегодня.
      </p>

      <a href={LMS_URL} class="btn btn-solid mt-8">
        Начать обучение
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="lg:col-span-6 lg:pt-20 min-w-0" data-reveal>
      <p class="t-mono mb-4">связаться</p>
      <ul class="border-t border-line">
        {
          CONTACTS.map((contact) => (
            <li>
              <a
                href={contact.href}
                target={contact.external ? '_blank' : undefined}
                rel={contact.external ? 'noopener noreferrer' : undefined}
                class="group flex items-baseline gap-4 border-b border-line py-4 font-mono text-[0.8125rem] transition-colors hover:bg-raised"
              >
                <span class="w-32 shrink-0 text-ink-faint">{contact.key}</span>
                <span class="text-ink-dim transition-colors group-hover:text-accent">{contact.value}</span>
                <span aria-hidden="true" class="ml-auto text-ink-faint transition-colors group-hover:text-accent">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
