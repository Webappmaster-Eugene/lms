---
/** Блок 04 — как устроено обучение. Шесть шагов вертикальной лентой
 *  в том же ритме, что и левый рельс. */
import SectionHead from './SectionHead.astro'
import Shot from './Shot.astro'

const STEPS = [
  {
    title: 'Выбери роадмап',
    description:
      'Frontend React или Backend Node.js — выбирай направление. Каждый роадмап включает интерактивную Miro-карту навыков.',
  },
  {
    title: 'Проходи курсы по порядку',
    description:
      'Курсы разбиты на секции и уроки. Каждый урок — видео с Яндекс.Диска + учебные материалы. Всё по порядку.',
  },
  {
    title: 'Отмечай прогресс',
    description:
      'Посмотрел урок — ставь галочку. Прогресс-бар покажет сколько осталось. Вернулся через неделю — продолжаешь с того же места.',
  },
  {
    title: 'Практикуйся в тренажёре',
    description:
      'Задачи по темам с разными уровнями сложности. Пишешь код, запускаешь, получаешь результат. Есть подсказки если застрял.',
  },
  {
    title: 'Набирай очки и достижения',
    description:
      '10 XP за урок, бонусы за курсы и роадмапы, баллы за задачи тренажёра. Открывай достижения, поднимайся в лидерборде.',
  },
  {
    title: 'Получай сертификат',
    description:
      'Завершил курс или роадмап — автоматически получаешь сертификат с уникальным номером. Подтверждение твоих знаний.',
  },
] as const
---

<section id="how-it-works" class="band border-t border-line-soft">
  <div class="shell">
    <SectionHead
      index="04"
      label="процесс"
      title="Как устроено обучение"
      lead="Простой и понятный процесс — от выбора направления до сертификата"
    />

    <ol class="relative max-w-4xl" data-reveal>
      <span aria-hidden="true" class="absolute bottom-6 left-[1.1875rem] top-3 w-px bg-line"></span>

      {
        STEPS.map((step, i) => (
          <li class="relative flex gap-5 pb-9 last:pb-0 sm:gap-7">
            <span class="t-num relative z-10 flex h-10 w-10 shrink-0 items-center justify-center border border-line bg-raised text-[0.8125rem] text-accent">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-1.5">
              <h3 class="t-h3 text-ink">{step.title}</h3>
              <p class="t-body mt-2 max-w-2xl">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 lg:mt-16" data-reveal>
      <p class="t-mono mb-4">шаг 01 — карта навыков роадмапа</p>
      <Shot
        src="/shots/roadmap.webp"
        width={1440}
        height={900}
        alt="Роадмап Frontend React в MentorCareer: граф навыков, пройденные узлы подсвечены, общий прогресс 39%"
        path="роадмап · frontend react"
        meta="23 курса"
      />
    </div>
  </div>
</section>
