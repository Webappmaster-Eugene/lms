---
import BootcampLayout from '../../layouts/BootcampLayout.astro'
import BootcampFooter from '../../components/BootcampFooter.astro'
import BootcampHeader from '../../components/BootcampHeader.astro'
import GuideScreen from '../../components/GuideScreen.astro'
import screens from '../../data/screens.json'
import { AUTHOR_URL, SITE_URL } from '../../config'
import {
  AUDIENCE, BOOTCAMP_PATH, CONSENT_PATH, CONSENT_VERSION, ENTRY_TASK_DAYS, ENTRY_TASK_MINUTES, FACTS, FAQ, LOG, MENTOR_EXPERIENCE, PAINS, PATH, PAYMENT_PATH, PREP_START, PRICE,
  PRIVACY_PATH, PROGRAM, QUALITY_PATH, RENTAL_FLOW, REVIEW_DAYS, SAMPLE_MANUAL, SAMPLE_QUESTIONS, START, START_ISO,
} from '../../data/bootcamp'

// В заголовке то, что ищут: «буткемп», «Node.js», «курс backend».
const title = 'Буткемп Node.js: курс backend с ревью наставника - MentorCareer'
const description = 'Backend на Node.js для frontend- и fullstack-разработчиков, junior и middle: 20 недель, свой проект в GitLab, CI и ревью каждой работы.'
const pageUrl = new URL(BOOTCAMP_PATH, SITE_URL).href
const schema = [
  {
    '@type': 'Course', '@id': `${pageUrl}#course`, name: 'Буткемп Node.js: backend сервиса проката', description, inLanguage: 'ru',
    audience: { '@type': 'EducationalAudience', audienceType: 'frontend- и fullstack-разработчики, junior и middle backend-разработчики' },
    provider: { '@id': `${SITE_URL}/#organization` },
    offers: { '@type': 'Offer', category: 'Paid', price: PRICE.value, priceCurrency: 'RUB', availability: 'https://schema.org/PreOrder', url: pageUrl },
    educationalLevel: 'Средний',
    coursePrerequisites: 'Уверенный JavaScript, чтение типов TypeScript, работа с Git',
    teaches: ['Node.js', 'TypeScript', 'HTTP API на Fastify', 'NestJS', 'PostgreSQL', 'Redis', 'RabbitMQ', 'Kafka', 'ClickHouse', 'Docker', 'OpenTelemetry', 'GitLab CI', 'оплата без двойных списаний', 'восстановление после сбоев'],
    syllabusSections: PROGRAM.map(({ weeks, topic }) => ({ '@type': 'Syllabus', name: `Недели ${weeks}`, description: topic })),
    hasCourseInstance: {
      '@type': 'CourseInstance', courseMode: 'online', inLanguage: 'ru', startDate: START_ISO,
      // 20 недель по 15-20 часов: в разметке нижняя граница.
      courseWorkload: 'PT300H',
      courseSchedule: { '@type': 'Schedule', repeatFrequency: 'P1W', repeatCount: 20, byDay: ['https://schema.org/Saturday', 'https://schema.org/Sunday'], startDate: START_ISO, scheduleTimezone: 'Europe/Moscow' },
      instructor: { '@id': `${pageUrl}#mentor` },
    },
  },
  {
    '@type': 'Person', '@id': `${pageUrl}#mentor`, name: 'Евгений Надточеев', url: AUTHOR_URL, sameAs: [AUTHOR_URL], jobTitle: 'Fullstack-разработчик, наставник',
    knowsAbout: ['Node.js', 'Fastify', 'NestJS', 'PostgreSQL', 'Kafka', 'платёжные системы', 'наблюдаемость'],
  },
  { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: FAQ.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
]
const extraSize = (screen: string) => {
  const size = Object.entries(screens).find(([name]) => name === screen)?.[1]
  if (!size) throw new Error(`Screenshot dimensions missing: ${screen}`)
  return size
}
---
<BootcampLayout title={title} description={description} schema={schema}>
  <BootcampHeader cta="#apply" />

  <main id="main">
    <section class="bc-hero" aria-labelledby="hero-title">
      <div class="bc-hero-copy">
        <p class="bc-tape">Идёт предзапись. Старт планируется {START}, неделя подготовки с {PREP_START}</p>
        <h1 id="hero-title">Буткемп Node.js: backend, о котором спрашивают на собеседованиях</h1>
        <p class="bc-lede">Для frontend- и fullstack-разработчиков, которые ищут работу, и для junior и middle, которые хотят вырасти как backend-разработчики. За 20 недель вы соберёте backend сервиса проката, от первого HTTP-маршрута до оплаты без двойных списаний, очередей и аналитики. Каждую неделю наставник читает ваш код.</p>
        <dl class="bc-facts">
          {FACTS.map(({ term, value }) => <div><dt>{term}</dt><dd>{value}</dd></div>)}
        </dl>
        <div class="bc-actions"><a class="bc-button" href="#apply">Оставить заявку</a><a class="bc-link" href="#week">Как проходит неделя</a></div>
      </div>
      <figure class="bc-log" aria-labelledby="log-caption">
        <div class="bc-log-bar"><span>журнал сервиса проката</span><span>сб, 13 марта</span></div>
        <ol class="bc-log-lines">
          {LOG.map((line) => (
            <li class={`bc-log-line is-${line.tone}`}>
              <span class="bc-log-time">{line.time}</span>
              <span class="bc-log-request"><b>{line.request}</b> {line.detail}</span>
              <span class="bc-log-result"><b>{line.code}</b> {line.result}</span>
            </li>
          ))}
        </ol>
        <figcaption id="log-caption">Одна дрель, два клиента с разницей в одну миллисекунду и повтор оплаты после обрыва связи. Код, после которого журнал выглядит именно так, вы пишете в неделях 3-8.</figcaption>
      </figure>
    </section>

    <section class="bc-section" id="pains" aria-labelledby="pains-title">
      <h2 id="pains-title">Что обычно мешает</h2>
      <dl class="bc-pains">
        {PAINS.map(({ pain, answer }) => <div><dt>{pain}</dt><dd>{answer}</dd></div>)}
      </dl>
    </section>

    <section class="bc-section" id="fit" aria-labelledby="fit-title">
      <h2 id="fit-title">Для кого этот буткемп</h2>
      <p class="bc-intro">Для разработчиков, которые уверенно пишут на JavaScript и хотят глубже освоить backend на большом учебном проекте.</p>
      <div class="bc-audience">
        {AUDIENCE.map(({ title: who, text }) => <div><h3>{who}</h3><p>{text}</p></div>)}
      </div>
      <div class="bc-columns bc-needs">
        <div>
          <h3>Что нужно уметь</h3>
          <p>Писать на JavaScript: промисы, async/await, модули, классы. Читать типы TypeScript. Работать с Git: ветки, коммиты, merge request. И найти 15-20 часов в неделю на все 20 недель.</p>
        </div>
        <div>
          <h3>Что знать заранее не нужно</h3>
          <p>NestJS, SQL, брокеры сообщений и Docker. Им посвящена программа.</p>
          <p>Перед зачислением вы делаете короткое входное задание: три функции на JavaScript прямо в браузере, на {ENTRY_TASK_MINUTES} минут. Оно приходит на email сразу после заявки: на него {ENTRY_TASK_DAYS}, ответ в течение {REVIEW_DAYS}. Если в основах JavaScript есть пробелы, мы подскажем, что подтянуть, и предложим следующий поток. Оплату в этом случае не берём.</p>
        </div>
      </div>
      <div class="bc-actions"><a class="bc-button" href="#apply">Оставить заявку</a></div>
    </section>

    <section class="bc-section bc-mentor" id="mentor" aria-labelledby="mentor-title">
      <div>
        <h2 id="mentor-title">Наставник</h2>
        <p class="bc-mentor-name">Евгений Надточеев</p>
        <p>Fullstack-разработчик с упором на backend. Сам ведёт занятия, проверяет работы и принимает защиты всех участников.</p>
        <a class="bc-link" href={AUTHOR_URL} target="_blank" rel="noopener noreferrer">Подробнее на nadtocheev.ru</a>
      </div>
      <div>
        <p>{MENTOR_EXPERIENCE} в коммерческой разработке. Поддерживает микросервисы, которыми пользуются больше 40 тысяч человек в день, с нагрузкой до 2000 запросов в секунду. Перевёл сервисы с Express на Fastify: по замерам k6 задержка упала вдвое при той же памяти. Строил учёт денег на реальных платежах без двойных списаний, с доставкой событий через Outbox и Kafka.</p>
        <p>Два года преподаёт: больше 30 платных и 50 бесплатных консультаций, лекции в Школе 21, наставничество в Purple School, менторство на Solvery, GetMentor и H.Careers.</p>
      </div>
    </section>

    <section class="bc-section" id="product" aria-labelledby="product-title">
      <h2 id="product-title">Что вы построите</h2>
      <p class="bc-intro">Сервис проката инструментов. Клиент находит дрель, бронирует её на выходные, оплачивает, забирает в пункте выдачи и возвращает.</p>
      <ol class="bc-flow" aria-label="Путь клиента в сервисе проката">
        {RENTAL_FLOW.map((step) => <li>{step}</li>)}
      </ol>
      <div class="bc-two bc-two-tight">
        <p>За простым сценарием стоят задачи, которые есть в любом backend. Каждую неделю проект получает одно изменение, и его принимают по ревью и автоматическим проверкам.</p>
        <p>Каталог нужно перенести из старой системы и не потерять данные. Одну дрель нельзя отдать двум клиентам, даже если они нажали «Забронировать» в одну секунду. Оплата не должна списаться второй раз, если запрос повторился после обрыва связи. Сети пунктов проката нужны тарифы и подписки. События между сервисами не должны теряться при сбое. А ещё нужно строить отчёты по миллионам событий и быстро искать по каталогу.</p>
      </div>
    </section>

    <section class="bc-section" id="week" aria-labelledby="week-title">
      <h2 id="week-title">Как проходит неделя</h2>
      <div class="bc-two bc-two-tight">
        <p>Неделя устроена как работа над задачей в команде. В субботу двухчасовое занятие: теория, постановка задачи и разбор примера. В воскресенье полтора часа: типовые ошибки, упражнение и ответы на вопросы.</p>
        <p>Между занятиями вы читаете методичку и делаете задачу в своём проекте. Дальше решение проходит тот же путь, что код в рабочей команде: merge request, автоматические проверки, ревью и слияние. Ниже этот путь на настоящих экранах.</p>
      </div>
      <p class="bc-sample">На скриншотах демонстрационный ученик сдаёт первую неделю. <span class="note-wide">Нажмите «Показать шаги», чтобы пройти по экрану с подсказками, или «Увеличить», чтобы рассмотреть его целиком.</span><span class="note-narrow">Снимок сразу приближен к первому шагу. Чтобы перейти к следующему, нажмите стрелку над снимком или проведите по нему пальцем. Кнопка «Весь экран» откроет снимок крупно.</span></p>
      <ol class="bc-path">
        {PATH.map((chapter) => (
          <li class="bc-path-chapter" id={chapter.id}>
            <h3>{chapter.title}</h3>
            <p>{chapter.intro}</p>
            <GuideScreen id={chapter.id} screen={chapter.screen} alt={chapter.alt} steps={chapter.steps} folder="bootcamp/path" level={4} />
            {chapter.extra && (
              <figure class="bc-extra">
                <img src={`/bootcamp/path/${chapter.extra.screen}.webp`} alt={chapter.extra.alt} width={extraSize(chapter.extra.screen).width} height={extraSize(chapter.extra.screen).height} loading="lazy" decoding="async" />
                <figcaption><span>{chapter.extra.caption}</span><button type="button" class="bc-zoom" data-zoom-static aria-haspopup="dialog">Увеличить</button></figcaption>
              </figure>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section class="bc-section" id="program" aria-labelledby="program-title">
      <h2 id="program-title">Программа</h2>
      <table class="bc-program">
        <caption class="sr-only">Темы программы по неделям</caption>
        <thead><tr><th scope="col">Недели</th><th scope="col">Что изучаем на проекте</th></tr></thead>
        <tbody>{PROGRAM.map(({ weeks, topic }) => <tr><th scope="row">{weeks}</th><td>{topic}</td></tr>)}</tbody>
      </table>
    </section>

    <section class="bc-section" id="result" aria-labelledby="result-title">
      <h2 id="result-title">С чем вы выйдете</h2>
      <div class="bc-columns bc-columns-three bc-result">
        <div>
          <h3>Проект, о котором есть что рассказать</h3>
          <p>Один сервис, который вы строили 20 недель: история коммитов, merge request с ревью наставника, зелёный CI. На собеседовании вы говорите о решениях, которые принимали сами, и о сбоях, которые сами разбирали. В конце вы защищаете проект перед наставником.</p>
        </div>
        <div>
          <h3>Навыки backend-разработчика</h3>
          <p>Проектировать HTTP API и схему PostgreSQL под реальные сценарии. Находить и устранять гонки, когда одни и те же данные меняют одновременно. Проводить оплату без двойных списаний. Строить обмен событиями, который переживает сбои. Собирать аналитику на ClickHouse. Искать причину проблемы по метрикам, логам и трассировке запросов.</p>
        </div>
        <div>
          <h3>Паспорт навыков</h3>
          <p>После защиты вы получаете паспорт навыков: список умений, подтверждённых вашим кодом и защитой, со ссылками на тесты, merge request и отчёты в проекте. Это не диплом, а проверяемое описание того, что вы умеете, его можно показать вместе с репозиторием.</p>
        </div>
      </div>
      <p class="bc-note">Если вы строите свой продукт: неделя 12 посвящена тарифам, подпискам, пробному периоду и лимитам, а для основателей есть необязательный трек. Запуск бизнеса и доход мы не обещаем, трек помогает правильно построить эту часть продукта.</p>
    </section>

    <section class="bc-section" id="career" aria-labelledby="career-title">
      <h2 id="career-title">Если вы ищете работу</h2>
      <div class="bc-columns bc-result">
        <div>
          <h3>Входит в стоимость</h3>
          <p>164 вопроса собеседования в разделах методичек, по каждой теме программы. Защита проекта: вы показываете сервис, отвечаете на вопросы и меняете код при наставнике. Паспорт навыков, который можно показать вместе с репозиторием.</p>
        </div>
        <div>
          <h3>Карьерный трек</h3>
          <p>На 8-й неделе разбираем рынок вакансий Node.js и путь из frontend. На 14-й собираем резюме, профиль на hh.ru и README проекта. На 15-17-й наставник разбирает ваше резюме, на 18-й говорим об этапах собеседования, а на 19-20-й проводим личное пробное собеседование на 45 минут.</p>
          <p>Трек не входит в стоимость, его условия обсуждаются отдельно. Трудоустройство мы не гарантируем: трек помогает показать ваши реальные навыки.</p>
        </div>
      </div>
    </section>

    <section class="bc-section bc-columns" id="setup" aria-label="Компьютер и среда">
      <div>
        <h2>Компьютер</h2>
        <p>Нужен компьютер с 4 ядрами или больше, 16 ГБ памяти (лучше 32) и 40 ГБ свободного места на SSD. Подойдут macOS на Apple Silicon или Intel, Windows 10 или 11 с WSL2 и Linux. Для контейнеров нужен Docker: Docker Desktop, Rancher Desktop или Colima.</p>
        <p>До оплаты вы запускаете скрипт проверки компьютера. Если машина не потянет весь стенд, вы узнаете об этом заранее.</p>
      </div>
      <div>
        <h2>Среда</h2>
        <p>Мы даём закрытый репозиторий в GitLab курса, CI и проверку каждой сдачи на закрытых тестах, учебный кабинет с методичками, чат участников и записи занятий. Доступ к методичкам и записям остаётся у вас и после выпуска, без ограничения срока.</p>
        <p>PostgreSQL, Redis, RabbitMQ, Kafka и ClickHouse вы запускаете в Docker на своём компьютере, как локальный стенд разработчика. Описание стенда в compose.yaml вы ведёте сами, как в рабочем проекте.</p>
      </div>
    </section>

    <section class="bc-section" id="quality" aria-labelledby="quality-title">
      <h2 id="quality-title">Как мы отвечаем за качество</h2>
      <div class="bc-columns bc-columns-three bc-result">
        <div>
          <h3>Программу прошли сами</h3>
          <p>Для каждой из 20 недель есть наше эталонное решение. Перед стартом все недели сданы через GitLab курса тем же путём, что пройдёте вы: merge request, CI, закрытые тесты.</p>
        </div>
        <div>
          <h3>Тесты ловят типовые ошибки</h3>
          <p>Мы вносим в эталон больше 400 типичных ошибок в backend-коде, например дробную сумму денег или текст внутренней ошибки в ответе API. Каждая должна проваливать проверку. Тест, который ошибку пропустил, чиним до старта.</p>
        </div>
        <div>
          <h3>Каждую работу читает человек</h3>
          <p>Автоматические проверки не заменяют ревью. Все работы всех участников наставник проверяет сам и отвечает на каждую сдачу в течение {REVIEW_DAYS}, поэтому в группе не больше 20 человек.</p>
        </div>
      </div>
      <a class="bc-link" href={QUALITY_PATH}>Подробно о том, как устроены проверки и методички</a>
    </section>

    <section class="bc-section" id="materials" aria-labelledby="materials-title">
      <h2 id="materials-title">Посмотрите материалы до заявки</h2>
      <div class="bc-two bc-two-tight">
        <div>
          <p>Методичка первой недели целиком: теория, разобранные примеры, задание и вопросы собеседования. Так устроена каждая из 21 методички программы.</p>
          <a class="bc-link" href={SAMPLE_MANUAL.href} target="_blank" rel="noopener">Открыть методичку недели 1 (PDF, {SAMPLE_MANUAL.pages} страниц, {SAMPLE_MANUAL.size})</a>
        </div>
        <div>
          <p>Три вопроса собеседования из недели про оплату:</p>
          <ol class="bc-list">{SAMPLE_QUESTIONS.map((question) => <li>{question}</li>)}</ol>
        </div>
      </div>
    </section>

    <section class="bc-section" id="payment" aria-labelledby="payment-title">
      <h2 id="payment-title">Как устроена оплата</h2>
      <div class="bc-two bc-two-tight">
        <p>Сейчас идёт предзапись, платить ничего не нужно. Стоимость буткемпа {PRICE.text} за весь поток. Деньги мы берём только после входного задания и решения о допуске. До оплаты вы получаете договор-оферту: программа, сроки, цена и порядок возврата.</p>
        <p>Заплатить можно одним платежом картой или через СБП либо в рассрочку от банка-партнёра платёжного сервиса. Рассрочку предлагаем только без переплаты для вас, кредит с процентами не предлагаем. Отказаться от обучения можно в любой момент: вернём деньги за оставшиеся недели. Карьерный трек в стоимость не входит, его условия обсуждаются отдельно.</p>
      </div>
      <a class="bc-link" href={PAYMENT_PATH}>Подробно об оплате, договоре и возврате</a>
    </section>

    <section class="bc-section" id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Частые вопросы</h2>
      <div class="bc-faq">{FAQ.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="bc-section bc-apply" id="apply" aria-labelledby="apply-title">
      <div class="bc-apply-copy">
        <h2 id="apply-title">Оставьте заявку, и входное задание сразу придёт на email</h2>
        <p>Точное время занятий и договор-оферту пришлём, когда откроется набор в январе 2027 года. Сейчас идёт предзапись: заявка ни к чему не обязывает, оплаты на этой странице нет.</p>
      </div>
      <form class="bc-form" data-lead-form data-consent-version={CONSENT_VERSION} novalidate>
        <div class="bc-field">
          <label for="lead-email">Email</label>
          <input id="lead-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="lead-email-error" />
          <p class="bc-error" id="lead-email-error" data-error-for="email" hidden></p>
        </div>
        <div class="bc-field">
          <label for="lead-name">Имя <span class="bc-optional">необязательно</span></label>
          <input id="lead-name" name="name" type="text" autocomplete="given-name" maxlength="100" />
        </div>
        <div class="bc-trap" aria-hidden="true">
          <label for="lead-website">Сайт</label>
          <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="bc-consent">
          <input id="lead-consent" name="consent" type="checkbox" required aria-describedby="lead-consent-error" />
          <label for="lead-consent">Даю <a href={CONSENT_PATH} target="_blank">согласие на обработку персональных данных</a>: email и имени, чтобы получить ответ на заявку. Мне есть 18 лет</label>
          <p class="bc-error" id="lead-consent-error" data-error-for="consent" hidden></p>
        </div>
        <button class="bc-button" type="submit" data-submit>Оставить заявку</button>
        <p class="bc-form-status" data-status role="status" aria-live="polite"></p>
        <noscript><p class="bc-form-status">Чтобы отправить заявку, включите JavaScript.</p></noscript>
        <p class="bc-form-note">Как мы храним и удаляем данные, написано в <a href={PRIVACY_PATH} target="_blank">политике обработки персональных данных</a>.</p>
      </form>
      <div class="bc-done" data-done tabindex="-1" hidden>
        <h3>Заявка сохранена</h3>
        <p>На <strong data-done-email></strong> ушло письмо с личной ссылкой на входное задание. Если письма нет, проверьте папку «Спам». Не нашли и через 15 минут, отправьте заявку ещё раз: письмо придёт повторно.</p>
      </div>
    </section>
  </main>

  <BootcampFooter />
  <dialog class="image-dialog" aria-labelledby="image-dialog-title">
    <div class="dialog-toolbar"><h2 id="image-dialog-title">Скриншот</h2><div class="dialog-actions"><button type="button" class="dialog-fit" data-dialog-fit>Целиком</button><button type="button" data-close-dialog>Закрыть <span aria-hidden="true">×</span></button></div></div>
    <div class="dialog-image-scroll"><img alt="" /></div>
    <p data-dialog-description></p>
  </dialog>
  <script src="../../scripts/bootcamp-form.ts"></script>
  <script src="../../scripts/walkthrough.ts"></script>
</BootcampLayout>
