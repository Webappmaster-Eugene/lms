---
import Layout from '../layouts/Layout.astro'
import Rail from '../components/Rail.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Diagnosis from '../components/Diagnosis.astro'
import Mentor from '../components/Mentor.astro'
import Program from '../components/Program.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Platform from '../components/Platform.astro'
import ForMentors from '../components/ForMentors.astro'
import ContactCTA from '../components/ContactCTA.astro'
import Footer from '../components/Footer.astro'
---

<Layout>
  <Rail />
  <Header />
  <main id="main">
    <Hero />
    <Diagnosis />
    <Mentor />
    <Program />
    <HowItWorks />
    <Platform />
    <ForMentors />
    <ContactCTA />
  </main>
  <Footer />
</Layout>
