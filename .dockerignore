# Dependencies (в том числе вложенные: landing/node_modules иначе попадает
# в контекст и маскирует ошибки, которые проявятся только на сервере)
node_modules
**/node_modules
.pnpm-store

# Build artifacts
.next
out
dist
build
tsconfig.tsbuildinfo

# Git
.git
.gitignore

# Environment files (secrets injected at runtime)
.env
.env.*

# IDE
.idea
.vscode
.cursor
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Uploaded media (mounted as volume)
media

# Logs
*.log

# Отчёты, артефакты и сессии Playwright
playwright-report
test-results
tests/e2e/.auth

# Documentation & misc
*.md
LICENSE

# Образу приложения не нужно. Любой файл в контексте сбрасывает кеш `COPY . .`,
# и правка лендинга, теста или документа пересобирала платформу на Pi (~2 ч).
# Лендинг собирается из своего контекста landing/ со своим .dockerignore.
landing
tests
docs
.github
playwright*.config.ts
vitest*.config.ts
scripts/landing-server.mjs
scripts/e2e-server.mjs
scripts/test-db.mjs
scripts/test-trainer-runtime.mjs
scripts/visual-docker.mjs
scripts/prod-test-accounts.mjs
scripts/codex

# Локальная инфраструктура агентов
.codex
.agents
.claude
